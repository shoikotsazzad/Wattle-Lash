# Copy to .env.local and fill in. Never commit .env.local.

# Final site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB (Atlas or local). Without it the shop shows the seed catalogue read-only and checkout is off.
MONGODB_URI=

# Signs login cookies. Any long random string: `openssl rand -base64 32`
AUTH_SECRET=

# Admin account. `npm run seed` creates it, or updates the existing admin if you change these.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Cloudinary (admin product photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional analytics (mention in Privacy Policy if used)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
